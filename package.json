    "@react-navigation/native": "^7.1.8",
    "@react-navigation/routers": "^7.5.5",
    "@tanstack/react-query": "^5.100.11",
    "babel-preset-expo": "~57.0.0",
    "better-auth": "^1.6.11",
    "clsx": "^2.1.1",
    "expo": "57",
    "expo-constants": "~57.0.17",
    "expo-image-picker": "~57.0.15",
    "expo-linking": "~57.0.9",
    "expo-location": "~57.0.15",
