{
  "expo": {
    "name": "Harrison - House of Inasal & BBQ",
    "slug": "harrison-inasal",
    "scheme": "harrison",
    "version": "1.0.0",
    "web": {
      "favicon": "./assets/images/harrison_square.jpg",
      "bundler": "metro"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "orientation": "portrait",
    "icon": "./assets/images/harrison_square.jpg",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.harrisoninasal.harrisoninasal"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7d12b52b-83f9-4fcc-86f4-606c5b416ae8"
      }
    }
  }
}
